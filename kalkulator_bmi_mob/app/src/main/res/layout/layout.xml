<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4aa31d">

    <TextView
        android:id="@+id/waga"
        android:layout_width="209dp"
        android:layout_height="31dp"
        android:gravity="center"
        android:text="podaj wagę"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/liczba1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <EditText
        android:id="@+id/liczba1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/waga"
        app:layout_constraintBottom_toTopOf="@+id/wzrost"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/wzrost"
        android:layout_width="209dp"
        android:layout_height="31dp"
        android:gravity="center"
        android:text="podaj wzrost"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/liczba1"
        app:layout_constraintBottom_toTopOf="@+id/liczba2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <EditText
        android:id="@+id/liczba2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/wzrost"
        app:layout_constraintBottom_toTopOf="@+id/oblicz"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <Button
        android:id="@+id/oblicz"
        android:layout_width="228dp"
        android:layout_height="64dp"
        android:text="OBLICZ"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/liczba2"
        app:layout_constraintBottom_toTopOf="@+id/wynik"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/wynik"
        android:layout_width="209dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/oblicz"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:text="Twój wynik pojawi się tutaj" />

</androidx.constraintlayout.widget.ConstraintLayout>